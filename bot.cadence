# Search for a target, then track it and look again if it slips out of the scan.
# Clunkyard guide: https://clunkyard.com/sdk/cadence
bot My robot
modes 2d 3d
rulesets classic inertial-2d gravity-flat gravity-hills zero-g
initial search

# Alternate sides after each shot heard. Each dodge lasts ten ticks.
routine dodge
  set dodges dodges + (tick >= dodge-until and muzzle-heard)
  set dodge-until max(dodge-until, (tick >= dodge-until and muzzle-heard) * (tick + 10))
  set dodging tick < dodge-until
  set side 1 - 2 * (dodges % 2 == 0)
end

# Keep the hull level while the force controls are active.
routine level-hull
  pitch-torque clamp(-pitch / 40 - pitch-rate / 60, -1, 1)
  roll-torque clamp(-roll-rate / 60, -1, 1)
end

# Keep the turret working while steering out of danger.
routine scan-and-fire
  aim-heading bearing
  set lob elevation - gravity-z * 28.6 / max(range, shot-speed-base + shot-speed-per-power * power-max)
  aim-pitch lob
  scan-heading bearing * contact + (scan-heading + 36) * (not contact)
  scan-pitch elevation
  scan-arc (not contact) * 40 + contact * min(40, max(6, 2 * atan2(30, range), scan-arc / 2))
  set shot clamp((range - shot-speed-base) / shot-speed-per-power, power-min, power-max)
  power shot
  fire contact and cooldown == 0 and abs(aim-error) < 3 and range * bearing-error / 57.3 < 12 and abs(lob - aim-pitch) < 3 and battery >= shot-cost-base + shot-cost-per-power * shot + 10
end

state search
  enter set dodges 0
  enter set dodge-until 0
  # Start updating the dodge before choosing a heading.
  each do dodge
  # Under a quarter battery, drive at half speed.
  each drive dodging * (1 - 0.5 * (battery-fraction < 0.25)) + (not dodging) * (0.6 - 0.3 * (battery-fraction < 0.25))
  each turn dodging * side + (not dodging) * 0.25
  each pitch clamp(-pitch / 45, -1, 1)
  each thrust dodging * 0.5 * (1 - 0.5 * (battery-fraction < 0.25)) + (not dodging) * (0.6 - 0.3 * (battery-fraction < 0.25))
  each strafe -(dodging * side)
  each yaw-torque clamp(0.2 - yaw-rate / 60, -1, 1)
  each lift clamp(-gravity-z / 100 + gravity * (60 - altitude) / 100 - vz / 50, -1, 1)
  each do level-hull
  each brake speed > 70
  # Sweep for contacts. Hold the beam when a contact appears.
  each scan-heading scan-heading + 36 * (not contact)
  each scan-pitch wave(31, 25) * (not contact) + elevation * contact
  each scan-arc 40
  when storm-distance < 60 -> storm
  when zone-active and zone-distance > zone-radius - 60 -> home
  when contact -> track
  when cue-present -> listen
end

# Sweep around the direction of the passive cue.
state listen
  each do dodge
  each drive dodging * (1 - 0.5 * (battery-fraction < 0.25)) + (not dodging) * (0.6 - 0.3 * (battery-fraction < 0.25))
  each turn dodging * side + (not dodging) * clamp(angle(cue-bearing, heading) / 45, -1, 1)
  each pitch clamp(-pitch / 45, -1, 1)
  each thrust dodging * 0.5 * (1 - 0.5 * (battery-fraction < 0.25)) + (not dodging) * (0.6 - 0.3 * (battery-fraction < 0.25))
  each strafe -(dodging * side)
  each yaw-torque clamp(angle(cue-bearing, heading) / 70 - yaw-rate / 60, -1, 1)
  each lift clamp(-gravity-z / 100 + gravity * (60 - altitude) / 100 - vz / 50, -1, 1)
  each do level-hull
  each brake speed > 70
  each scan-heading cue-bearing + wave(14, cue-error + 10)
  each scan-pitch cue-elevation * (not contact) + elevation * contact
  each scan-arc 30
  when storm-distance < 60 -> storm
  when zone-active and zone-distance > zone-radius - 60 -> home
  when contact -> track
  when not cue-present -> search
end

# Head across the storm's path so it can pass by.
state storm
  each set out storm-heading + 90 - 180 * (angle(storm-bearing, storm-heading) > 0)
  each turn clamp(angle(out, heading) / 30, -1, 1)
  each pitch clamp(-pitch / 45, -1, 1)
  each drive 1
  each thrust 0.8
  each yaw-torque clamp(angle(out, heading) / 70 - yaw-rate / 60, -1, 1)
  each lift clamp(-gravity-z / 100 + gravity * (60 - altitude) / 100 - vz / 50, -1, 1)
  each do level-hull
  each do scan-and-fire
  when storm-distance > 100 -> search
end

state track
  # Circle the target to keep moving across its line of fire.
  each pitch clamp(-pitch / 45, -1, 1)
  each do dodge
  each turn dodging * side + (not dodging) * clamp(angle(bearing + 90 + wave(50, 30), heading) / 45, -1, 1)
  each drive dodging * (1 - 0.5 * (battery-fraction < 0.25)) + (not dodging) * (0.5 - 0.25 * (battery-fraction < 0.25))
  each thrust dodging * 0.5 * (1 - 0.5 * (battery-fraction < 0.25)) + (not dodging) * clamp((range - 200) / 180, -0.5, 0.6) * (1 - 0.5 * (battery-fraction < 0.25))
  each strafe -(dodging * side)
  each yaw-torque clamp(angle(bearing, heading) / 70 - yaw-rate / 60, -1, 1)
  each lift clamp(-gravity-z / 100 + gravity * (60 - altitude) / 100 - vz / 50, -1, 1)
  each do level-hull
  each brake speed > 70
  each aim-heading bearing
  # Aim higher to account for gravity.
  each set lob elevation - gravity-z * 28.6 / max(range, shot-speed-base + shot-speed-per-power * power-max)
  each aim-pitch lob
  each scan-heading bearing
  each scan-pitch elevation
  # Narrow the beam for a better bearing. Widen it every 40 ticks to find closer robots.
  each scan-arc 40 * (tick % 40 == 0) + (tick % 40 != 0) * min(40, max(6, 2 * atan2(30, range), scan-arc / 2))
  # Save the bearing for the reacquire state.
  each set last-bearing bearing
  each set last-elevation elevation
  # Choose the heaviest shot that travels the range in about a second.
  each set shot clamp((range - shot-speed-base) / shot-speed-per-power, power-min, power-max)
  each power shot
  # Wait for a precise bearing and leave 10 battery in reserve.
  each fire contact and cooldown == 0 and abs(aim-error) < 3 and range * bearing-error / 57.3 < 12 and abs(lob - aim-pitch) < 3 and battery >= shot-cost-base + shot-cost-per-power * shot + 10
  when storm-distance < 60 -> storm
  when zone-active and zone-distance > zone-radius - 60 -> home
  when not contact -> reacquire
end

# Widen the beam around the last known bearing for ten ticks.
state reacquire
  each do dodge
  each drive dodging * (1 - 0.5 * (battery-fraction < 0.25)) + (not dodging) * (0.5 - 0.25 * (battery-fraction < 0.25))
  each turn dodging * side + (not dodging) * clamp(angle(last-bearing, heading) / 45, -1, 1)
  each pitch clamp(-pitch / 45, -1, 1)
  each thrust dodging * 0.5 * (1 - 0.5 * (battery-fraction < 0.25)) + (not dodging) * 0.3
  each strafe -(dodging * side)
  each yaw-torque clamp(angle(last-bearing, heading) / 70 - yaw-rate / 60, -1, 1)
  each lift clamp(-gravity-z / 100 + gravity * (60 - altitude) / 100 - vz / 50, -1, 1)
  each do level-hull
  each brake speed > 70
  each scan-heading last-bearing
  each scan-pitch last-elevation
  each scan-arc min(40, scan-arc * 2)
  when storm-distance < 60 -> storm
  when zone-active and zone-distance > zone-radius - 60 -> home
  when contact -> track
  after 10 -> search
end

state home
  # Head towards the middle of the safe zone.
  each turn clamp(angle(zone-bearing, heading) / 30, -1, 1)
  each pitch clamp((zone-elevation - pitch) / 30, -1, 1)
  each drive 0.8
  each thrust 0.6
  each yaw-torque clamp(angle(zone-bearing, heading) / 70 - yaw-rate / 60, -1, 1)
  each lift clamp(-gravity-z / 100 + gravity * (60 - altitude) / 100 + sin(zone-elevation) - vz / 50, -1, 1)
  each do level-hull
  each brake speed > 70
  each do scan-and-fire
  when zone-distance < zone-radius - 120 -> search
end
